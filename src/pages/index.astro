---
import Layout from "../components/layout.astro";
import { getMeetupEvents } from "../clients/getMeetupEvents";
import agendaData from "../../agenda.json";

const groupEvents = await getMeetupEvents(11478542);
const upcomingEvents = groupEvents?.filter((event) => !event.isPast) ?? [];
const pastEvents = groupEvents?.filter((event) => event.isPast) ?? [];

const pastEventsByMonth = pastEvents.reduce((acc, event) => {
  const date = new Date(event.dateTime);
  const monthName = date.toLocaleString("en-US", { month: "long", timeZone: "Europe/Madrid" });
  
  let group = acc.find(g => g.month === monthName);
  if (!group) {
    group = { month: monthName, events: [] };
    acc.push(group);
  }
  group.events.push(event);
  return acc;
}, [] as { month: string; events: typeof pastEvents }[]);

// Extract talks for Day 2 (Saturday, 2026-10-17)
const day2 = agendaData.schedule.conference.days.find((d) => d.index === 2);
const roomsData = day2 ? day2.rooms : {};

// Defined rooms matching the columns in schedule-instructions
const rooms = ["Track 1", "Track 2", "Track 3", "Track 4"];

// Group standard talks and assign dialog IDs
let talkCounter: Record<string, number> = { "Track 1": 0, "Track 2": 0, "Track 3": 0, "Track 4": 0 };
let lightningCounter = 0;

const processedRoomsData: Record<string, any[]> = {};

rooms.forEach((roomName) => {
  const rawTalks = roomsData[roomName] || [];
  processedRoomsData[roomName] = rawTalks.map((talk: any) => {
    const isLightning = talk.type === "Lighning talk" || talk.duration === "00:07";
    let dialogId = "";
    if (roomName === "Track 1" && talk.start === "10:00") {
      dialogId = "keynote";
    } else if (isLightning) {
      lightningCounter++;
      dialogId = `talk-lightning-${lightningCounter}-dialog`;
    } else {
      const trackNum = rooms.indexOf(roomName) + 1;
      talkCounter[roomName]++;
      dialogId = `talk-2-${trackNum}-${talkCounter[roomName]}-dialog`;
    }
    
    // Extract language from question 36
    const langAnswer = talk.answers?.find((a: any) => a.question === 36);
    const lang = langAnswer ? langAnswer.answer : "English";
    let langFlag = "/assets/img/gb_circle.svg";
    if (lang === "Spanish") langFlag = "/assets/img/es_circle.svg";
    else if (lang === "Catalan") langFlag = "/assets/img/cat_circle.svg";

    return {
      ...talk,
      isLightning,
      dialogId,
      lang,
      langFlag,
    };
  });
});

// Saturday slots configuration with custom rows representation
interface ScheduleRow {
  timeLabel: string;
  isSpecialSection: boolean;
  specialTitle?: string;
  isKeynote?: boolean;
  slotStart?: string;
  slotEnd?: string;
}

const SaturdayRows: ScheduleRow[] = [
  { timeLabel: "09:00 - 09:25", isSpecialSection: true, specialTitle: "Registration" },
  { timeLabel: "09:30 - 09:55", isSpecialSection: true, specialTitle: "Opening" },
  { timeLabel: "10:00 - 10:55", isSpecialSection: false, isKeynote: true, slotStart: "10:00", slotEnd: "10:55" },
  { timeLabel: "11:00 - 11:25", isSpecialSection: true, specialTitle: "Break" },
  { timeLabel: "11:30 - 12:25", isSpecialSection: false, slotStart: "11:30", slotEnd: "12:25" },
  { timeLabel: "12:30 - 13:25", isSpecialSection: false, slotStart: "12:30", slotEnd: "13:25" },
  { timeLabel: "13:30 - 14:55", isSpecialSection: true, specialTitle: "Lunch" },
  { timeLabel: "15:00 - 15:55", isSpecialSection: false, slotStart: "15:00", slotEnd: "15:55" },
  { timeLabel: "16:00 - 16:55", isSpecialSection: false, slotStart: "16:00", slotEnd: "16:55" },
  { timeLabel: "17:00 - 17:25", isSpecialSection: true, specialTitle: "Break" },
  { timeLabel: "17:30 - 18:25", isSpecialSection: false, slotStart: "17:30", slotEnd: "18:25" },
  { timeLabel: "18:30 - 19:00", isSpecialSection: true, specialTitle: "Closing" },
];

const getTalkEndTime = (start: string, duration: string) => {
  const [startH, startM] = start.split(":").map(Number);
  const [durH, durM] = duration.split(":").map(Number);
  let endM = startM + durM;
  let endH = startH + durH + Math.floor(endM / 60);
  endM = endM % 60;
  return `${String(endH).padStart(2, "0")}:${String(endM).padStart(2, "0")}`;
};
---

