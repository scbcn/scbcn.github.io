                    <div class="media">
                      <img src="/assets/img/preview/people-sm.jpg" alt="" />
                      <div class="caption hovered">
                        <div class="caption-wrapper div-table">
                          <div class="caption-inner div-cell">
                            <p class="caption-buttons">
                              <a
                                href="/assets/img/preview/people-lg.jpg"
                                class="btn caption-zoom"
                                data-gal="prettyPhoto"
                                ><i class="fa fa-search"></i></a
                              >
                            </p>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div
                    class="thumbnail no-border no-padding"
                    data-animation="fadeInLeft"
                    data-animation-delay="100"
                  >
                    <div class="media">
                      <img src="/assets/img/preview/about-h-sm-10.jpg" alt="" />
                      <div class="caption hovered">
                        <div class="caption-wrapper div-table">
                          <div class="caption-inner div-cell">
                            <p class="caption-buttons">
                              <a
                                href="/assets/img/preview/about-h-lg-10.jpg"
                                class="btn caption-zoom"
                                data-gal="prettyPhoto"
                                ><i class="fa fa-search"></i></a
                              >
                            </p>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div
                    class="thumbnail no-border no-padding"
                    data-animation="fadeInDown"
                    data-animation-delay="200i"
                  >
                    <div class="media">
                      <img src="/assets/img/preview/team22-sm.jpg" alt="" />
                      <div class="caption hovered">
                        <div class="caption-wrapper div-table">
                          <div class="caption-inner div-cell">
                            <p class="caption-buttons">
                              <a
                                href="/assets/img/preview/team22-lg.jpg"
                                class="btn caption-zoom"
                                data-gal="prettyPhoto"
                                ><i class="fa fa-search"></i></a
                              >
                            </p>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="col-sm-1 col-xs-1"></div>
              </div>
              <!-- /Thumbnails -->
            </div>
        </div>
      </div>
      <!-- /PAGE ABOUT -->

      <!-- PAGE SCHEDULE -->
      <section class="page-section" id="schedule">
        <div class="container">
          <h1 class="section-title">
            <span
              data-animation="flipInY"
              data-animation-delay="300"
              class="icon-inner"
              ><span class="fa-stack"
                ><i class="fa rhex fa-stack-2x"></i><i
                  class="fa fa-calendar fa-stack-1x"></i></span
              ></span
            >
            <span
              data-animation="fadeInRight"
              data-animation-delay="500"
              class="title-inner"
              >Schedule <small>/ 16 & 17 October</small></span
            >
          </h1>

          <div class="schedule-wrapper clear" data-animation="fadeIn" data-animation-delay="200">
            <div class="schedule-tabs lv1">
              <ul id="tabs-lv1" class="nav nav-justified">
                <li class="active">
                  <a href="#tab-first" data-toggle="tab">
                    <strong>Friday</strong><br />16.10.2026
                  </a>
                </li>
                <li>
                  <a href="#tab-second" data-toggle="tab">
                    <strong>Saturday</strong><br />17.10.2026
                  </a>
                </li>
              </ul>
            </div>

            <div class="tab-content lv1">
              <!-- DAY 1: Friday Open Space -->
              <div id="tab-first" class="tab-pane fade in active">
                <div class="schedule-tabs lv2">
                  <ul id="tabs-lv21" class="nav nav-justified">
                    <li class="active">
                      <a href="#tab-lv21-first" data-toggle="tab">
                        Open Space<br />
                        <img src="/assets/img/sponsors/540-flat.png" height="50" alt="540" />
                      </a>
                    </li>
                  </ul>
                </div>
                <div class="tab-content lv2">
                  <div id="tab-lv21-first" class="tab-pane fade in active">
                    <div class="timeline">
                      <!-- Registration -->
                      <article class="post-wrap" data-animation="fadeInUp" data-animation-delay="200">
                        <div class="media">
                          <div class="schedule-width">
                            <div class="post-header">
                              <div class="post-meta">
                                <span class="post-date"><i class="fa fa-clock-o"></i> 17:00 - 17:25</span>
                              </div>
                              <h2 class="post-title">Registration</h2>
                            </div>
                            <div class="post-body">
                              <div class="post-excerpt">
                                <br />
                              </div>
                            </div>
                          </div>
                        </div>
                      </article>

                      <!-- Opening -->
                      <article class="post-wrap" data-animation="fadeInUp" data-animation-delay="300">
                        <div class="media">
                          <div class="schedule-width">
                            <div class="post-header">
                              <div class="post-meta">
                                <span class="post-date"><i class="fa fa-clock-o"></i> 17:30 - 17:40</span>
                              </div>
                              <h2 class="post-title">Opening</h2>
                            </div>
                            <div class="post-body">
                              <div class="post-excerpt">
                                <br />
                              </div>
                            </div>
                          </div>
                        </div>
                      </article>

                      <!-- Open Space -->
                      <article class="post-wrap" data-animation="fadeInUp" data-animation-delay="300">
                        <div class="media">
                          <div class="schedule-width">
                            <div class="post-header">
                              <div class="post-meta">
                                <span class="post-date"><i class="fa fa-clock-o"></i> 17:45 - 20:00</span>
                              </div>
                              <h2 class="post-title">Open Space</h2>
                            </div>
                            <div class="post-body">
                              <div class="post-excerpt">
                                <p>
                                  An Open Space is a self-organized event where, unlike a traditional conference, everyone participates interactively in defining sessions and their development. Despite being self-organized, there are simple dynamics to carry it out:
                                </p>
                                <p>
                                  - Those who attend propose specific topics. They do not necessarily have to lead these topics, it can be a question that among the attendees you also have it and you want to talk more about the topic. You don’t need expert people in the session, just people who want to talk about the topic.
                                </p>
                                <p>
                                  - These topics are voted on by all attendees and the discussion topics are organized into “tracks”.
                                </p>
                                <p>
                                  - If you feel that you are not contributing or are not interested in the topic, you are free to enter and exit the session.
                                </p>
                              </div>
                            </div>
                            <div class="sc-avatar-wrapper">
                              <img src="/assets/img/preview/logo.png" alt="Software Crafters Barcelona" />
                            </div>
                          </div>
                        </div>
                      </article>

                      <!-- Closing -->
                      <article class="post-wrap" data-animation="fadeInUp" data-animation-delay="300">
                        <div class="media">
                          <div class="schedule-width">
                            <div class="post-header">
                              <div class="post-meta">
                                <span class="post-date"><i class="fa fa-clock-o"></i> 20:00 - 21:00</span>
                              </div>
                              <h2 class="post-title">Cocktail / Networking</h2>
                            </div>
                            <div class="post-body">
                              <div class="post-excerpt">
                                <br />
                              </div>
                            </div>
                          </div>
                        </div>
                      </article>
                    </div>
                  </div>
                </div>
              </div>

              <!-- DAY 2: Saturday Conference -->
              <div id="tab-second" class="tab-pane fade table-responsive">
                <table class="table table-bordered table-striped">
                  <thead>
                    <tr>
                      <th></th>
                      <th>Track 1</th>
                      <th>Track 2</th>
                      <th>Track 3</th>
                      <th>
                        <img src="/assets/img/sponsors/540-flat.png" alt="540" height="50" />
                      </th>
                    </tr>
                  </thead>
                  <tbody>
                    {SaturdayRows.map((row) => (
                      <tr>
                        <td class="time-block">{row.timeLabel}</td>
                        {row.isSpecialSection ? (
                          <td colspan="4" class="special-section">{row.specialTitle}</td>
                        ) : row.isKeynote ? (
                          (() => {
                            const keynoteTalk = processedRoomsData["Track 1"].find((t) => t.start === row.slotStart);
                            return keynoteTalk ? (
                              <td colspan="4" onclick={`window['${keynoteTalk.dialogId}'].showModal()`}>
                                <img class="language-flag" src={keynoteTalk.langFlag} alt={keynoteTalk.lang} />
                                <span class="title">{keynoteTalk.title}</span><br />
                                <span class="author">
                                  {keynoteTalk.persons.map((p) => (
                                    <img src={p.avatar || "/assets/img/preview/logo.png"} alt={p.public_name} />
                                  ))}
                                  {keynoteTalk.persons.map((p) => p.public_name).join(" & ")}
                                </span>
                                <dialog id={keynoteTalk.dialogId} onclick="event.stopPropagation()">
                                  <div class="post-excerpt">
                                    <h2 class="post-title">{keynoteTalk.title}</h2>
                                    <p class="track-tag"><strong>Track:</strong> {keynoteTalk.track}</p>
                                    <p>{keynoteTalk.abstract}</p>
                                    {keynoteTalk.persons.map((p) => (
                                      <div class="speaker-bio-container" style="margin-top: 15px; border-top: 1px solid #eee; padding-top: 10px; display: flex; gap: 15px; align-items: start;">
                                        <img src={p.avatar || "/assets/img/preview/logo.png"} alt={p.public_name} style="width: 60px; height: 60px; border-radius: 50%; object-fit: cover;" />
                                        <div>
                                          <h4 style="margin: 0; font-weight: bold;">{p.public_name}</h4>
                                          <p style="font-size: 0.9em; color: #666; margin: 5px 0 0 0;">{p.biography || "No biography available."}</p>
                                        </div>
                                      </div>
                                    ))}
                                  </div>
                                  <form method="dialog">
                                    <button class="dialog-close">Close</button>
                                  </form>
                                </dialog>
                              </td>
                            ) : (
                              <td colspan="4" class="special-section">-</td>
                            );
                          })()
                        ) : (
                          rooms.map((roomName) => {
                            const talksInSlot = processedRoomsData[roomName].filter((t) => t.start >= row.slotStart! && t.start < row.slotEnd!);
                            if (talksInSlot.length === 0) {
                              return <td>-</td>;
                            }
                            const isLightningCell = talksInSlot.some((t) => t.isLightning);
                            if (isLightningCell) {
                              return (
                                <td class="lightning-talks">
                                  <h4>⚡ Lightning Talks</h4>
                                  {talksInSlot.map((talk) => (
                                    <div onclick={`window['${talk.dialogId}'].showModal()`}>
                                      <img class="language-flag" src={talk.langFlag} alt={talk.lang} />
                                      {talk.start} - {getTalkEndTime(talk.start, talk.duration)} | {talk.title}<br />
                                      <span class="author">
                                        {talk.persons.map((p) => (
                                          <img src={p.avatar || "/assets/img/preview/logo.png"} alt={p.public_name} />
                                        ))}
                                        {talk.persons.map((p) => p.public_name).join(" & ")}
                                      </span>
                                      <dialog id={talk.dialogId} onclick="event.stopPropagation()">
                                        <div class="post-excerpt">
                                          <h2 class="post-title">{talk.title}</h2>
                                          <p class="track-tag"><strong>Track:</strong> {talk.track}</p>
                                          <p>{talk.abstract}</p>
                                          {talk.persons.map((p) => (
                                            <div class="speaker-bio-container" style="margin-top: 15px; border-top: 1px solid #eee; padding-top: 10px; display: flex; gap: 15px; align-items: start;">
                                              <img src={p.avatar || "/assets/img/preview/logo.png"} alt={p.public_name} style="width: 60px; height: 60px; border-radius: 50%; object-fit: cover;" />
                                              <div>
                                                <h4 style="margin: 0; font-weight: bold;">{p.public_name}</h4>
                                                <p style="font-size: 0.9em; color: #666; margin: 5px 0 0 0;">{p.biography || "No biography available."}</p>
                                              </div>
                                            </div>
                                          ))}
                                        </div>
                                        <form method="dialog">
                                          <button class="dialog-close">Close</button>
                                        </form>
                                      </dialog>
                                    </div>
                                  ))}
                                </td>
                              );
                            } else {
                              const talk = talksInSlot[0];
                              return (
                                <td onclick={`window['${talk.dialogId}'].showModal()`}>
                                  <img class="language-flag" src={talk.langFlag} alt={talk.lang} />
                                  {talk.title}<br />
                                  <span class="author">
                                    {talk.persons.map((p) => (
                                      <img src={p.avatar || "/assets/img/preview/logo.png"} alt={p.public_name} />
                                    ))}
                                    {talk.persons.map((p) => p.public_name).join(" & ")}
                                  </span>
                                  <dialog id={talk.dialogId} onclick="event.stopPropagation()">
                                    <div class="post-excerpt">
                                      <h2 class="post-title">{talk.title}</h2>
                                      <p class="track-tag"><strong>Track:</strong> {talk.track}</p>
                                      <p>{talk.abstract}</p>
                                      {talk.persons.map((p) => (
                                        <div class="speaker-bio-container" style="margin-top: 15px; border-top: 1px solid #eee; padding-top: 10px; display: flex; gap: 15px; align-items: start;">
                                          <img src={p.avatar || "/assets/img/preview/logo.png"} alt={p.public_name} style="width: 60px; height: 60px; border-radius: 50%; object-fit: cover;" />
                                          <div>
                                            <h4 style="margin: 0; font-weight: bold;">{p.public_name}</h4>
                                            <p style="font-size: 0.9em; color: #666; margin: 5px 0 0 0;">{p.biography || "No biography available."}</p>
                                          </div>
                                        </div>
                                      ))}
                                    </div>
                                    <form method="dialog">
                                      <button class="dialog-close">Close</button>
                                    </form>
                                  </dialog>
                                </td>
                              );
                            }
                          })
                        )}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
