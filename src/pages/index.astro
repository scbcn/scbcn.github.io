                    </h4>
                    <p class="text-muted" style="font-size: 0.9em;">
                      <i class="fa fa-clock-o" />{" "}
                      {new Date(event.dateTime).toLocaleString("en-US", {
                        weekday: "long",
                        year: "numeric",
                        month: "long",
                        day: "numeric",
                        hour: "2-digit",
                        minute: "2-digit",
                        timeZone: "Europe/Madrid",
